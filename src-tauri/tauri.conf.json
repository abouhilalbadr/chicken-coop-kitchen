{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chickencoop",
  "version": "1.0.0",
  "identifier": "com.chicken-coop.cyou",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": true,
        "resizable": true,
        "title": "Chicken Coop",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://gist.githubusercontent.com/abouhilalbadr/6866958b56e6f0b32a49e676ca78fd4e/raw/"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0N0FENEVGREIwRkU0MQpSV1JCL3JEOVRxMUhCbmJIK1ZDQmNHUGVKRVlrelFLVU1lSGVIS09YbmJIRFRPM0pReENwemVCbAo="
    },
    "http": {
      "all": true,
      "request": true
    },
    "shell": {
      "all": false,
      "open": true
    }
  }
}
